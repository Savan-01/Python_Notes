#For fetching the Cleans strings like " 15% ", "20 %", or "5.5%" into clean numeric strings like "15", "20", "5.5"
df["discount_rate"] = df["discount_rate"].str.replace(r'[% ]', '', regex=True)

#For fetching the Cleans mixed formats like "INV-9901-A" or "PO#4502" to leave only the digits "9901" and "4502"
df["invoice_id"] = df["invoice_id"].str.replace(r'[^0-9]', '', regex=True)

